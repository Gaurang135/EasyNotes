# Optional grounded "Ask" (RAG) layer — copy to .env and fill in. .env is gitignored.
# EasyNotes works fully without this (search + structured Data views need no LLM);
# setting these turns on the ✦ Ask tab. Any OpenAI-compatible endpoint works.

# Google Gemini free tier (recommended — high free-tier throughput, good quality):
ANSWER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
ANSWER_API_KEY=your_ai_studio_key_here          # get one at https://aistudio.google.com/apikey
ANSWER_MODEL=gemini-3.1-flash-lite              # or gemini-3.6-flash for best quality

# …or Groq free tier:
#   ANSWER_BASE_URL=https://api.groq.com/openai/v1
#   ANSWER_API_KEY=gsk_your_key_here
#   ANSWER_MODEL=openai/gpt-oss-120b
# …or fully local / offline via Ollama (no key):
#   ANSWER_BASE_URL=http://localhost:11434/v1
#   ANSWER_MODEL=llama3.2
