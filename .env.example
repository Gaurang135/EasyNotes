# Optional grounded "Ask" (RAG) layer — copy to .env and fill in. .env is gitignored.
# Groq free tier (recommended):
ANSWER_BASE_URL=https://api.groq.com/openai/v1
ANSWER_API_KEY=gsk_your_key_here
ANSWER_MODEL=openai/gpt-oss-120b
# Or local Ollama (no key):  ANSWER_BASE_URL=http://localhost:11434/v1  ANSWER_MODEL=llama3.2
